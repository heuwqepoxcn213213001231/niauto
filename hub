local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

local audio = {
 sfxOn = true,
 master = 0.8,
 music = 0.7,
 sfx = 0.85,
}

local function isMusicSound(sound)
 local n = string.lower(sound.Name)
 if sound.Looped then return true end
 return n:find("music", 1, true)
  or n:find("bgm", 1, true)
  or n:find("theme", 1, true)
  or n:find("soundtrack", 1, true)
  or n:find("ambient", 1, true)
end

local function applySound(sound)
 if not sound:IsA("Sound") then return end
 if sound:GetAttribute("NiaVol") == nil then
  sound:SetAttribute("NiaVol", sound.Volume)
 end
 local base = sound:GetAttribute("NiaVol")
 if not audio.sfxOn then
  sound.Volume = 0
  return
 end
 local bus = isMusicSound(sound) and audio.music or audio.sfx
 sound.Volume = math.clamp(base * audio.master * bus, 0, 2)
end

local function scanSounds(root)
 if not root then return end
 for _, inst in ipairs(root:GetDescendants()) do
  if inst:IsA("Sound") then applySound(inst) end
 end
end

local function applyAllSounds()
 pcall(function()
  SoundService.Volume = audio.sfxOn and audio.master or 0
 end)
 pcall(function()
  local ugs = UserSettings():GetService("UserGameSettings")
  if ugs.MasterVolume ~= nil then
   ugs.MasterVolume = audio.sfxOn and audio.master or 0
  end
 end)
 scanSounds(SoundService)
 scanSounds(LocalPlayer:FindFirstChild("PlayerGui"))
end

local function paintUi()
 local T = NiaHub.Theme
 local gui = Window._gui
 if not gui then return end
 gui.BackgroundColor3 = T.Background
 for _, inst in ipairs(gui:GetDescendants()) do
  if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
   if inst.TextTransparency < 1 then
    local small = (inst.TextSize or 14) <= 12
    inst.TextColor3 = small and T.TextDim or T.Text
   end
   if inst:IsA("TextBox") then
    inst.PlaceholderColor3 = T.TextDim
   end
  elseif inst:IsA("UIStroke") then
   inst.Color = T.Accent
  elseif inst.Name == "Window" and inst:IsA("Frame") then
   inst.BackgroundColor3 = T.Background
  elseif inst.Name == "Indicator" and inst:IsA("Frame") then
   inst.BackgroundColor3 = T.Accent
  end
 end
end

local function applyDark(on)
 local T = NiaHub.Theme
 if on then
  T.Background = Color3.fromRGB(16, 16, 16)
  T.Surface = Color3.fromRGB(24, 24, 24)
  T.Text = Color3.fromRGB(240, 240, 240)
  T.TextDim = Color3.fromRGB(150, 150, 155)
 else
  T.Background = Color3.fromRGB(236, 236, 240)
  T.Surface = Color3.fromRGB(255, 255, 255)
  T.Text = Color3.fromRGB(22, 22, 24)
  T.TextDim = Color3.fromRGB(100, 100, 108)
 end
 paintUi()
end

local function applyPrimary(color)
 NiaHub.Theme.Accent = color
 paintUi()
end

local function applySecondary(color)
 NiaHub.Theme.Surface = color
 local gui = Window._gui
 if not gui then return end
 for _, inst in ipairs(gui:GetDescendants()) do
  if inst:IsA("Frame") and (inst.Name == "Notification" or inst.Name == "Card" or inst.BackgroundTransparency > 0.8) then
   if inst.BackgroundTransparency < 1 and inst.Name ~= "Window" and inst.Name ~= "Glass" then
    inst.BackgroundColor3 = color
   end
  end
 end
end

