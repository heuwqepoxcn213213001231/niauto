local function cheapestVent()
	local folder = mapFolder("Vents")
	if not folder then
		return nil
	end
	local best, bestC
	for _, v in folder:GetChildren() do
		if v:IsA("BasePart") and v:GetAttribute("Cost") ~= nil and not v:GetAttribute("Unlocked") then
			local rakeOk = v:GetAttribute("Rake") ~= true or lp:GetAttribute("OwnsRake") == true
			local c = tonumber(v:GetAttribute("Cost")) or 0
			if rakeOk and cash() >= c and (not bestC or c < bestC) then
				best, bestC = v, c
			end
		end
	end
	return best, bestC
end

