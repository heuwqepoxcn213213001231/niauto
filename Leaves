local function copyList(src)
	local t = {}
	for i, v in ipairs(src) do
		t[i] = v
	end
	return t
end

local function mergePrereq(base, extra)
	local t = {}
	for k, v in pairs(base) do
		t[k] = v
	end
	if type(extra) == "table" then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return t
end

local function applyMapLayout()
	if MAP_NAME == "Mansion" then
		ZONE_ORDER = copyList(MANSION_ORDER)
		ZONE_PREREQ = mergePrereq(MANSION_PREREQ, nil)
	elseif MAP_NAME == "GasStation" then
		ZONE_ORDER = copyList(GAS_ORDER)
		ZONE_PREREQ = mergePrereq(GAS_PREREQ, nil)
	else
		ZONE_ORDER = copyList(HOUSE_ORDER)
		ZONE_PREREQ = mergePrereq(HOUSE_PREREQ, nil)
	end
	pcall(function()
		local folder = workspace:FindFirstChild("Map")
		local mod = folder and folder:FindFirstChild("MapConfig")
		if mod then
			local cfg = require(mod)
			if cfg and type(cfg.zonePrereq) == "table" then
				ZONE_PREREQ = mergePrereq(ZONE_PREREQ, cfg.zonePrereq)
			end
		end
	end)
	local seen = {}
	for _, n in ipairs(ZONE_ORDER) do
		seen[n] = true
	end
	local loc = mapFolder("Leave_Locations")
	if loc then
		for _, z in loc:GetChildren() do
			if z:IsA("Model") and z:GetAttribute("GoalTotal") and not seen[z.Name] then
				local at = #ZONE_ORDER
				if ZONE_ORDER[at] == "Maze" or ZONE_ORDER[at] == "Basement" then
					table.insert(ZONE_ORDER, at, z.Name)
				else
					ZONE_ORDER[#ZONE_ORDER + 1] = z.Name
				end
				seen[z.Name] = true
			end
		end
	end
	print("[HandCollect] map", MAP_NAME, "zones", #ZONE_ORDER)
end

