local function detectMap()
 local id = game.PlaceId
 if id == PLACE.Lobby then return "Lobby" end
 if id == PLACE.Mansion then return "Mansion" end
 local am = workspace:GetAttribute("ActiveMap")
 if type(am) == "string" and am ~= "" then return am end
 local loc = workspace:FindFirstChild("Map")
 loc = loc and loc:FindFirstChild("Leave_Locations")
 if loc then
  if loc:FindFirstChild("Basement") or loc:FindFirstChild("Garage") then return "House" end
  if loc:FindFirstChild("Tennis Court") or loc:FindFirstChild("[F] Left Alley") then return "Mansion" end
  if loc:FindFirstChild("Staff Room") then return "GasStation" end
  return "Farm"
 end
 if workspace:FindFirstChild("Teams") and workspace.Teams:FindFirstChild("Square1") then
  return "Lobby"
 end
 return "Lobby"
end

