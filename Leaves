local function insideZone(model, pos, pad)
	if not (model and pos) then
		return false
	end
	pad = pad or 4
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local v = child.CFrame:PointToObjectSpace(pos)
			if math.abs(v.X) <= child.Size.X / 2 + pad
				and math.abs(v.Z) <= child.Size.Z / 2 + pad
				and v.Y >= -child.Size.Y / 2 - 6
				and v.Y <= child.Size.Y / 2 + 14 then
				return true
			end
		end
	end
	return false
end

local function distOutsideFloor(model, pos)
	if not (model and pos) then
		return math.huge
	end
	local best = math.huge
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local v = child.CFrame:PointToObjectSpace(pos)
			local dx = math.max(0, math.abs(v.X) - child.Size.X / 2)
			local dz = math.max(0, math.abs(v.Z) - child.Size.Z / 2)
			local dy = math.max(0, math.abs(v.Y) - child.Size.Y / 2 - 8)
			local d = math.sqrt(dx * dx + dz * dz + dy * dy)
			if d < best then
				best = d
			end
		end
	end
	return best
end

local function zoneSellReady(name)
	if not name or name == "None" then
		return true
	end
	local loc = mapFolder("Leave_Locations")
	loc = loc and loc:FindFirstChild(name)
	if loc then
		if loc:GetAttribute("Completed") == true then
			return true
		end
		if (tonumber(loc:GetAttribute("WavesCleared")) or 0) > 0 then
			return true
		end
	end
	local doors = mapFolder("Doors")
	if not doors then
		return false
	end
	local saw, allOpen = false, true
	for _, d in doors:GetChildren() do
		if d:IsA("Model") and d:GetAttribute("Zone") == name then
			saw = true
			if d:GetAttribute("Open") ~= true then
				allOpen = false
			end
		end
	end
	return saw and allOpen
end

local function zoneModel(name)
	local loc = mapFolder("Leave_Locations")
	return loc and name and loc:FindFirstChild(name)
end

local function zoneDone(name)
	local z = zoneModel(name)
	if not z then
		return false
	end
	if z:GetAttribute("Completed") == true then
		return true
	end
	local got = tonumber(z:GetAttribute("GoalCollected")) or 0
	local tot = tonumber(z:GetAttribute("GoalTotal")) or 0
	if tot <= 0 or got < tot then
		return false
	end
	local w = tonumber(z:GetAttribute("WavesCleared")) or 0
	local wt = tonumber(z:GetAttribute("WavesTotal")) or 0
	return wt <= 0 or w >= wt
end

