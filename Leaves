}

local function zonePrereqReady(name)
	local p = ZONE_PREREQ[name]
	if not p then
		return true
	end
	if p == "ALL" then
		for _, n in ipairs(ZONE_ORDER) do
			if n ~= name then
				local z = zoneModel(n)
				if z and z:GetAttribute("GoalTotal") and not zoneDone(n) then
					return false
				end
			end
		end
		return true
	end
	for _, n in ipairs(p) do
		if not zoneDone(n) then
			return false
		end
	end
	return true
end

local function allZonesDone()
	local loc = mapFolder("Leave_Locations")
	if not loc then
		return false
	end
	for _, z in loc:GetChildren() do
		if z:IsA("Model") and z:GetAttribute("GoalTotal") and z:GetAttribute("Completed") ~= true then
			return false
		end
	end
	return true
end

local function zoneProgress(name)
	local z = zoneModel(name)
	if not z then
		return 0, 0, 0, 0
	end
	return tonumber(z:GetAttribute("GoalCollected")) or 0,
		tonumber(z:GetAttribute("GoalTotal")) or 0,
		tonumber(z:GetAttribute("WavesCleared")) or 0,
		tonumber(z:GetAttribute("WavesTotal")) or 0
end

local function leafVisible(p)
	return p:IsA("BasePart") and p.Transparency < 0.2
end

local function openLeaves(zoneName, maxOut)
	local folder = workspace:FindFirstChild("Leaves")
	if not folder then
		return {}
	end
	local origin = hrp()
	origin = origin and origin.Position or Vector3.zero
	local zone = zoneModel(zoneName)
	local list = {}
	for _, p in folder:GetChildren() do
		if leafVisible(p) then
			local ok = not zone
			if zone then
				ok = distOutsideFloor(zone, p.Position) <= (maxOut or 3)
			end
			if ok then
				list[#list + 1] = { p = p, d = (p.Position - origin).Magnitude }
			end
		end
	end
	table.sort(list, function(a, b)
		return a.d < b.d
	end)
	return list
end

local function huntLeaves(zoneName)
	for _, maxOut in ipairs({ 3, 6, 10 }) do
		local list = openLeaves(zoneName, maxOut)
		if #list > 0 then
			return list
		end
	end
	return {}
end

local usedIds = {}
local failStreak = 0
local BATCH = 75
local lastClearName = ""
local leftoverIdx = 0

local function leafSim()
	local m = lp:FindFirstChild("PlayerScripts")
	m = m and m:FindFirstChild("LeafSim")
	if not m then
		return nil
	end
	local ok, api = pcall(require, m)
	return ok and api or nil
end

local function idTable(api)
	if not (api and type(api.collectMany) == "function") then
		return nil
	end
	local getup = (type(debug) == "table" and debug.getupvalue) or getupvalue
	if type(getup) ~= "function" then
		return nil
	end
	local ok, a, b = pcall(getup, api.collectMany, 3)
	if ok and type(b) == "table" then
		return b
	end
	if ok and type(a) == "table" then
		return a
	end
	return nil
end

local function fireIds(ids)
	if #ids == 0 then
		return 0
	end
	if #ids == 1 then
		CollectLeaf:FireServer(ids[1])
	else
		CollectLeaf:FireServer(ids)
	end
	return #ids
end

local function wipeGhosts(list, map)
	local n = 0
	for _, e in list do
		local id = map and map[e.p]
		if type(id) == "number" and usedIds[id] and e.p.Parent then
			e.p:Destroy()
			n = n + 1
		end
	end
	return n
end

local function grab(need, zoneName)
	local list = zoneName and huntLeaves(zoneName) or openLeaves()
	if #list == 0 then
		return 0
	end
	local api = leafSim()
	local map = idTable(api)
	local take = math.max(1, math.min(need, BATCH))
	local parts, ids = {}, {}
	for _, e in list do
		local id = map and map[e.p]
		if type(id) == "number" then
			if not usedIds[id] then
				parts[#parts + 1] = e.p
				ids[#ids + 1] = id
			end
		elseif e.d <= 8 then
			parts[#parts + 1] = e.p
		end
		if #parts >= take then
			break
		end
	end
	if #parts == 0 then
		table.clear(usedIds)
		return 0
	end
	local before = tonumber(lp:GetAttribute("Leaves")) or 0
	if api and type(api.collectMany) == "function" then
		api.collectMany(parts)
	elseif #ids > 0 then
		fireIds(ids)
	else
		return 0
	end
	local t0 = os.clock()
	repeat
		task.wait(0.01)
	until (tonumber(lp:GetAttribute("Leaves")) or 0) > before or os.clock() - t0 > 0.7
	local after = tonumber(lp:GetAttribute("Leaves")) or 0
	if after <= before then
		failStreak = failStreak + 1
		if failStreak >= 8 then
			for _, id in ids do
				usedIds[id] = true
			end
			failStreak = 0
		end
		return 0
	end
	failStreak = 0
	for _, id in ids do
		usedIds[id] = true
	end
	return after - before
end

local function teleToOpenLeaf(force, zoneName)
	local list = zoneName and huntLeaves(zoneName) or openLeaves()
	if #list == 0 then
		return false
	end
	local api = leafSim()
	local map = idTable(api)
	for _, e in list do
		local id = map and map[e.p]
		if type(id) ~= "number" or not usedIds[id] then
			if force or e.d > 8 then
				return tpTo(e.p.Position)
			end
			return false
		end
	end
	wipeGhosts(list, map)
	list = zoneName and huntLeaves(zoneName) or openLeaves()
	if #list == 0 then
		return false
	end
	return tpTo(list[1].p.Position)
end

local function dumpsterNone()
	local folder = mapFolder("Dumpsters")
	if not folder then
		return nil
	end
	for _, d in folder:GetChildren() do
		if d:IsA("Model") then
			local req = d:GetAttribute("ZoneRequired")
			if not req or req == "None" then
				return d
			end
		end
	end
	return nil
end

local function sellDumpster()
	local folder = mapFolder("Dumpsters")
	if not folder then
		return nil
	end
	local origin = hrp()
	origin = origin and origin.Position or Vector3.zero
	local best, bestD
	for _, d in folder:GetChildren() do
		if d:IsA("Model") then
			local req = d:GetAttribute("ZoneRequired")
			if zoneSellReady(req) then
				local part = d:FindFirstChild("Leaves")
				local pos = (part and part:IsA("BasePart") and part.Position) or d:GetPivot().Position
				local dist = (pos - origin).Magnitude
				if not best or dist < bestD then
					best, bestD = d, dist
				end
			end
		end
	end
	return best or dumpsterNone()
end

local function dumpsterPos(dump)
	if not dump then
		return nil
	end
	local part = dump:FindFirstChild("Leaves")
	if part and part:IsA("BasePart") then
		return part.Position
	end
	return dump:GetPivot().Position
end

local function fireSellAt(dump)
	local root = hrp()
	local pos = dumpsterPos(dump)
	if not (root and pos) then
		return false
	end
	root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 2.5))
	task.wait(0.2)
	EmptyBackpack:FireServer()
	local t0 = os.clock()
	repeat
		task.wait(0.1)
	until (lp:GetAttribute("Leaves") or 0) <= 0 or os.clock() - t0 > 2.5
	if (lp:GetAttribute("Leaves") or 0) > 0 then
		EmptyBackpack:FireServer()
		task.wait(0.25)
	end
	return (lp:GetAttribute("Leaves") or 0) <= 0
end

local function sell()
	local cur = bag()
	if cur <= 0 then
		return true
	end
	if not hrp() then
		return false
	end
	local dump = sellDumpster()
	if not dump then
		warn("[HandCollect] no unlocked dumpster")
		return false
	end
	local saved = hrp().CFrame
	local ok = fireSellAt(dump)
	if not ok then
		local fallback = dumpsterNone()
		if fallback and fallback ~= dump then
			ok = fireSellAt(fallback)
			dump = fallback
		end
	end
	local left = lp:GetAttribute("Leaves") or 0
	print("[HandCollect] sell", cur, "→", left, dump:GetAttribute("ZoneRequired") or "None")
	pcall(function()
		local root = hrp()
		if root then
			root.CFrame = saved
		end
	end)
	task.wait(0.35)
	teleToOpenLeaf(true, lastClearName ~= "" and lastClearName or nil)
	return left <= 0
end

local lastBagBuy = 0
local function bagLevelFromCap(cap)
	local lvl = 0
	if type(BagConfig.caps) ~= "table" then
		return tonumber(lp:GetAttribute("BagLevel")) or 0
	end
	for i, c in ipairs(BagConfig.caps) do
		if cap >= c then
			lvl = i - 1
		end
	end
	return math.max(lvl, tonumber(lp:GetAttribute("BagLevel")) or 0)
end

local function tryUpgradeBag()
	if lp:GetAttribute("InfiniteBag") == true then
		return
	end
	local _, cap = bag()
	local lvl = bagLevelFromCap(cap)
	local maxLvl = #BagConfig.caps - 1
	if lvl >= maxLvl then
		return
	end
	local price = BagConfig.prices[lvl + 1]
	if not price or cash() < price then
		return
	end
	if os.clock() - lastBagBuy < 1.5 then
		return
	end
	lastBagBuy = os.clock()
	local cap0 = cap
	BuyBagUpgrade:FireServer()
	print("[HandCollect] bag upgrade lvl", lvl, "cash", cash(), "price", price)
	local t0 = os.clock()
	repeat
		task.wait(0.1)
	until select(2, bag()) ~= cap0 or os.clock() - t0 > 2
	table.clear(usedIds)
	failStreak = 0
	task.wait(0.4)
end

local function currentQuest()
	for i, q in ipairs(QuestConfig) do
		local have = tonumber(lp:GetAttribute("Quest" .. i)) or 0
		if have < q.total then
			return i, q, have
		end
	end
end

local function upgLevel(tool, name)
	return tonumber(lp:GetAttribute("Upg_" .. tool .. "_" .. name)) or 0
end

local function upgPrice(tool, name)
	local t = UpgradeConfig.tools and UpgradeConfig.tools[tool]
	local u = t and t.upgrades and t.upgrades[name]
	if not u then
		return nil
	end
	local lvl = upgLevel(tool, name)
	if lvl >= (u.max or 0) then
		return nil
	end
	return u.prices and u.prices[lvl + 1]
end

local lastHandBuy = 0
local function tryBuyHand(name)
	if not BuyUpgrade then
		return false
	end
	local price = upgPrice("Hand", name)
	if not price or cash() < price then
		return false
	end
	if os.clock() - lastHandBuy < 0.9 then
		return false
	end
	lastHandBuy = os.clock()
	BuyUpgrade:FireServer("Hand", name)
	print("[HandCollect] hand", name, "cash", cash(), "price", price)
	return true
end

local function tryHandUpgrades()
	if tryBuyHand("Hold") then
		return
	end
	local best, bestP
	for _, name in ipairs({ "Dexterity", "Grasp" }) do
		local p = upgPrice("Hand", name)
		if p and cash() >= p and (not bestP or p < bestP) then
			best, bestP = name, p
		end
	end
	if best then
		tryBuyHand(best)
	end
end

