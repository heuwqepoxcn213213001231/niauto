local function leafFolders()
	local out = {}
	local a = leafFolder()
	if a then
		out[1] = a
	end
	local map = workspace:FindFirstChild("Map")
	if map then
		for _, n in ipairs({ "FallingLeaves", "CollectionLeaves", "ActiveLeaves" }) do
			local f = map:FindFirstChild(n)
			if f then
				out[#out + 1] = f
			end
		end
	end
	return out
end

local function nearbyParts(radius)
	local folders = leafFolders()
	local root = hrp()
	if #folders == 0 or not root then
		return {}
	end
	overlap.FilterDescendantsInstances = folders
	local hits = workspace:GetPartBoundsInRadius(root.Position, radius or 20, overlap)
	local out = {}
	for _, p in hits do
		if leafVisible(p) then
			out[#out + 1] = p
			if #out >= BATCH then
				break
			end
		end
	end
	return out
end

local function oneZoneLeaf(zoneName, pad)
	local folders = leafFolders()
	local zone = zoneModel(zoneName)
	if #folders == 0 then
		return nil
	end
	overlap.FilterDescendantsInstances = folders
	local hits
	if zone then
		local cf, size = zone:GetBoundingBox()
		pad = pad or Vector3.new(18, 36, 18)
		hits = workspace:GetPartBoundsInBox(cf, size + pad, overlap)
	else
		local root = hrp()
		if not root then
			return nil
		end
		hits = workspace:GetPartBoundsInRadius(root.Position, 80, overlap)
	end
	for _, p in hits do
		if leafVisible(p) then
			return p
		end
	end
	return nil
end

local leafSim, idTable

local function leftoverInside(model, pos)
	if not (model and pos) then
		return false
	end
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") then
			local v = child.CFrame:PointToObjectSpace(pos)
			if math.abs(v.X) <= child.Size.X / 2 + 22
				and math.abs(v.Z) <= child.Size.Z / 2 + 22
				and v.Y >= -child.Size.Y / 2 - 16
				and v.Y <= child.Size.Y / 2 + 48 then
				return true
			end
		end
	end
	return false
end

local function leftoverZoneLeaves(zoneName)
	if leftoverCacheZone == zoneName and os.clock() - leftoverCacheAt < 1.2 then
		return leftoverCache
	end
	local zone = zoneModel(zoneName)
	local folder = leafFolder()
	local seen, out = {}, {}
	local function add(p)
		if not p or seen[p] or leftoverSkip[p] then
			return
		end
		if not p:IsA("BasePart") or p.Transparency >= 0.95 or p.Size.Magnitude < 0.12 then
			return
		end
		seen[p] = true
		out[#out + 1] = p
	end
	if folder and zone then
		overlap.FilterDescendantsInstances = { folder }
		local cf, size = zone:GetBoundingBox()
		for _, p in workspace:GetPartBoundsInBox(cf, size + Vector3.new(48, 72, 48), overlap) do
			if leafVisible(p) then
				add(p)
			end
		end
	end
	if #out == 0 then
		local map = idTable(leafSim())
		if map then
			for p, id in pairs(map) do
				if typeof(p) == "Instance" and p:IsA("BasePart") and type(id) == "number" then
					local z = p:GetAttribute("Zone") or p:GetAttribute("Location")
					if z == zoneName or leftoverInside(zone, p.Position) then
						add(p)
					end
				end
			end
		end
	end
	if #out == 0 then
		for _, f in leafFolders() do
			for _, inst in f:GetDescendants() do
				if inst:IsA("BasePart") then
					local z = inst:GetAttribute("Zone") or inst:GetAttribute("Location")
					if z == zoneName then
						add(inst)
					elseif not z and leftoverInside(zone, inst.Position) then
						add(inst)
					end
				end
			end
		end
	end
	leftoverCache, leftoverCacheAt, leftoverCacheZone = out, os.clock(), zoneName
	return out
end

local function leftoverZoneLeaf(zoneName)
	local list = leftoverZoneLeaves(zoneName)
	if #list == 0 then
		return nil
	end
	for _ = 1, #list do
		leftoverIdx = leftoverIdx % #list + 1
		local p = list[leftoverIdx]
		if p and p.Parent and not leftoverSkip[p] then
			return p
		end
	end
	return nil
end

function leafSim()
