local function detectMap()
	local am = workspace:GetAttribute("ActiveMap")
	if type(am) == "string" and am ~= "" then
		return am
	end
	pcall(function()
		local folder = workspace:FindFirstChild("Map")
		local mod = folder and folder:FindFirstChild("MapConfig")
		if mod then
			am = require(mod).name
		end
	end)
	if type(am) == "string" and am ~= "" then
		return am
	end
	local loc = workspace:FindFirstChild("Map")
	loc = loc and loc:FindFirstChild("Leave_Locations")
	if loc then
		if loc:FindFirstChild("Basement") or loc:FindFirstChild("Garage") then
			return "House"
		end
		if loc:FindFirstChild("Tennis Court") or loc:FindFirstChild("[F] Left Alley") then
			return "Mansion"
		end
		if loc:FindFirstChild("Staff Room") or loc:FindFirstChild("Inside Gas Station") then
			return "GasStation"
		end
		return "Farm"
	end
	if game.PlaceId == PLACE.Lobby then
		return "Lobby"
	end
	if workspace:FindFirstChild("Teams") and workspace.Teams:FindFirstChild("Square1") then
		return "Lobby"
	end
	return "Lobby"
end

local function waitFarmMap()
	local name = detectMap()
	if name ~= "Lobby" then
		return name
	end
	if game.PlaceId == PLACE.Lobby then
		return "Lobby"
	end
	local t0 = os.clock()
	while os.clock() - t0 < 8 do
		task.wait(0.15)
		name = detectMap()
		if name ~= "Lobby" then
			return name
		end
	end
	return detectMap()
end

