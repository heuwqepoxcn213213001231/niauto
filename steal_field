-- Steal An Egg — field steal. Fly CFrame 300 studs/s, steal, fly home.
-- Hub API: StartHandCollect / StopHandCollectRun / RefreshHandCollectStatus
-- Tat: getgenv().StopHandCollect = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local lp = Players.LocalPlayer
if not lp then
	repeat
		task.wait()
	until Players.LocalPlayer
	lp = Players.LocalPlayer
end

local FLY_SPEED = 300
local STEAL_RANGE = 7

local EggState, PlotState, SlotId, GuardGeom, AreaEggs
pcall(function()
	EggState = require(RS.Client.EggState)
	PlotState = require(RS.Client.PlotState)
	SlotId = require(RS.Shared.Util.AreaEggSlotIdentity)
	GuardGeom = require(RS.Shared.Util.GuardAreaGeometry)
	AreaEggs = require(RS.Shared.Types.AreaEggs)
end)

local isCarrying = false
if EggState and EggState.CarryChanged then
	EggState.CarryChanged:Connect(function(st)
		isCarrying = type(st) == "table" and st.IsCarrying == true
	end)
end

getgenv().HandCollectStatus = getgenv().HandCollectStatus or {
	running = false,
	leaves = 0,
	cap = 0,
	cash = 0,
	zone = "—",
	bag = "—",
	quest = "—",
	questName = "—",
	als = "—",
	zones = "—",
	place = "StealEgg",
	map = "StealEgg",
	placeId = game.PlaceId,
}

local function hrp()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function hum()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function allowedSpeed()
	return FLY_SPEED
end

local function groundY(pos)
	local origin = pos + Vector3.new(0, 8, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local char = lp.Character
	if char then
		params.FilterDescendantsInstances = { char }
	end
	local hit = workspace:Raycast(origin, Vector3.new(0, -40, 0), params)
	if hit then
		return hit.Position.Y + 3
	end
	return pos.Y
end

local function tweenTo(dest)
	local root = hrp()
	local h = hum()
	if not (root and dest) then
		return false
	end
	local goal = Vector3.new(dest.X, groundY(dest) + 2, dest.Z)
	local start = root.Position
	local flat = Vector3.new(goal.X - start.X, 0, goal.Z - start.Z)
	local dist = flat.Magnitude
	if dist < 1.2 then
		return true
	end
	local wasAnchored = root.Anchored
	local wasPlatform = h and h.PlatformStand
	root.Anchored = true
	if h then
		h.PlatformStand = true
		h.AutoRotate = false
	end
	local dir = flat.Unit
	local look = CFrame.lookAt(Vector3.zero, Vector3.new(dir.X, 0, dir.Z))
	local traveled = 0
	local ok = true
	while traveled < dist do
		if getgenv().StopHandCollect then
			ok = false
			break
		end
		local dt = RunService.Heartbeat:Wait()
		traveled = math.min(dist, traveled + FLY_SPEED * dt)
		local alpha = traveled / dist
		local pos = start:Lerp(goal, alpha)
		root.CFrame = CFrame.new(pos) * look.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	root.CFrame = CFrame.new(goal) * look.Rotation
	root.Anchored = wasAnchored
	if h then
		h.PlatformStand = wasPlatform or false
		h.AutoRotate = true
	end
	return ok
end

local function stealPromptNear(pos)
	local folder = workspace:FindFirstChild("AreaEggSlotsClient")
	if not (folder and pos) then
		return nil
	end
	local best, bestD
	for _, m in folder:GetChildren() do
		local p = m:FindFirstChild("CarryAreaEgg", true)
		if p and p:IsA("ProximityPrompt") then
			local at = m:GetPivot().Position
			local d = (at - pos).Magnitude
			if d < 14 and (not best or d < bestD) then
				best, bestD = p, d
			end
		end
	end
	return best
end

local function pressSteal(prompt)
	if not prompt then
		return
	end
	pcall(function()
		prompt.Enabled = true
		prompt.HoldDuration = workspace:GetAttribute("FastEggPickupTime") and 0.25 or 1.2
	end)
	if type(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, prompt)
		return
	end
	pcall(function()
		prompt:InputHoldBegin()
		task.wait(tonumber(prompt.HoldDuration) or 1.2)
		prompt:InputHoldEnd()
	end)
end

local function pastLine()
	local line = workspace:FindFirstChild("__OBJECTS")
	line = line and line:FindFirstChild("Areas")
	line = line and line:FindFirstChild("SeparationLine")
	local root = hrp()
	if not (line and root and GuardGeom) then
		return true
	end
	local ok, yes = pcall(GuardGeom.IsPastLine, GuardGeom, line, root.Position)
	return ok and yes == true
end

local function plotHome()
	if PlotState and type(PlotState.ResolvePlot) == "function" then
		local ok, info = pcall(PlotState.ResolvePlot, PlotState)
		if ok and type(info) == "table" then
			if info.CenterPoint then
				return info.CenterPoint.Position
			end
			if info.RespawnPointCFrame then
				return info.RespawnPointCFrame.Position
			end
		end
	end
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	local root = hrp()
	local origin = root and root.Position or Vector3.zero
	local best, bestD
	for _, p in plots:GetChildren() do
		local c = p:FindFirstChild("CenterPoint") or p:FindFirstChild("SpawnPoint")
		if c and c:IsA("BasePart") then
			local d = (c.Position - origin).Magnitude
			if not best or d < bestD then
				best, bestD = c.Position, d
			end
		end
	end
	return best
end

local lastSync = 0
local function fieldList()
	if not EggState then
		return {}
	end
	if os.clock() - lastSync > 2 then
		lastSync = os.clock()
		pcall(EggState.SyncFieldEggs)
	end
	local snap = EggState.ReadFieldEggs()
	local recs = type(snap) == "table" and (snap.Records or snap) or {}
	local out = {}
	local states = AreaEggs and AreaEggs.States
	for _, r in pairs(recs) do
		if type(r) == "table" and type(r.Uid) == "string" then
			local st = r.State
			local ok = st == "Slot" or st == "Dropped"
			if states then
				ok = st == states.Slot or st == states.Dropped
			end
			if ok and r.CarrierUserId == nil then
				local pos
				if typeof(r.BoundsCFrame) == "CFrame" then
					pos = r.BoundsCFrame.Position
				elseif typeof(r.BottomCFrame) == "CFrame" then
					pos = r.BottomCFrame.Position
				end
				if pos then
					out[#out + 1] = { rec = r, pos = pos }
				end
			end
		end
	end
	return out
end

local function closestEgg()
	local root = hrp()
	if not root then
		return nil
	end
	local best, bestD
	for _, e in fieldList() do
		local d = (e.pos - root.Position).Magnitude
		if not best or d < bestD then
			best, bestD = e, d
		end
	end
	return best
end

local function carrying()
	if isCarrying then
		return true
	end
	local char = lp.Character
	if not char then
		return false
	end
	if char:GetAttribute("IsTrapped") == true then
		return true
	end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and (string.find(string.lower(t.Name), "egg", 1, true) or t:GetAttribute("Uid")) then
			return true
		end
	end
	return false
end

local function stealOne(entry)
	if not (entry and EggState) then
		return false
	end
	if not tweenTo(entry.pos) then
		return false
	end
	local root = hrp()
	if not root or (root.Position - entry.pos).Magnitude > STEAL_RANGE + 3 then
		return false
	end
	local prompt = stealPromptNear(entry.pos)
	pressSteal(prompt)
	local slotKey
	if SlotId and SlotId.LooksLikeFirstAreaUid(entry.rec.Uid) then
		slotKey = SlotId.SlotKey(entry.rec.AreaId, entry.rec.NestId)
	end
	local ok, err = EggState.CarryFieldEgg(entry.rec.Uid, slotKey)
	if not ok and not carrying() then
		if prompt then
			pressSteal(prompt)
			task.wait(0.15)
		end
		ok, err = EggState.CarryFieldEgg(entry.rec.Uid, slotKey)
	end
	if not ok and not carrying() then
		print("[StealField] deny", entry.rec.Uid, err)
		return false
	end
	print("[StealField] steal", entry.rec.AreaId or "?", entry.rec.Uid)
	local home = plotHome()
	if home then
		tweenTo(home)
	end
	return true
end

local lastPrint = 0
local function tick()
	if carrying() then
		local home = plotHome()
		if home then
			tweenTo(home)
		end
		return
	end
	if not pastLine() then
		local eggs = fieldList()
		if #eggs > 0 then
			tweenTo(eggs[1].pos)
		end
		return
	end
	local egg = closestEgg()
	if not egg then
		if os.clock() - lastPrint > 5 then
			lastPrint = os.clock()
			print("[StealField] no field egg")
		end
		task.wait(0.6)
		return
	end
	stealOne(egg)
end

local function refresh()
	local st = getgenv().HandCollectStatus
	st.running = getgenv().HandCollectRunning == true
	st.place = "StealEgg"
	st.map = "StealEgg"
	st.placeId = game.PlaceId
	st.zone = carrying() and "carrying" or "field"
	st.bag = tostring(math.floor(allowedSpeed())) .. " / 300"
	st.quest = st.zone
	st.questName = "Steal field"
	st.als = "fly 300"
	local n = #fieldList()
	st.zones = tostring(n) .. " eggs"
	return st
end

local function start()
	if getgenv().HandCollectRunning then
		return
	end
	getgenv().StopHandCollect = false
	getgenv().HandCollectRunning = true
	getgenv().HandCollectStatus.running = true
	print("[StealField] fly steal | speed", FLY_SPEED)
	task.spawn(function()
		while not getgenv().StopHandCollect do
			local ok, err = pcall(tick)
			if not ok then
				warn("[StealField]", err)
			end
			task.wait(0.12)
		end
		getgenv().HandCollectRunning = false
		getgenv().HandCollectStatus.running = false
		print("[StealField] stop")
	end)
end

local function stop()
	getgenv().StopHandCollect = true
end

getgenv().RefreshHandCollectStatus = refresh
getgenv().StartHandCollect = start
getgenv().StopHandCollectRun = stop

if not getgenv().HandCollectHub then
	start()
end
