    for _ = 1, 10 do
     if not inst or inst == root then
      break
     end
     if inst.Name == "House" or inst.Name == "Mansion" or inst.Name == "GasStation" then
      raiseBeaten(inst.Name, 1)
      break
     end
     inst = inst.Parent
    end
   end
  end
 end
end

