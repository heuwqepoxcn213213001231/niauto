local CASH_TOOLS = { "Rake", "LeafBlower", "LeafMower", "Molotov" }
local function toolOwned(key)
	local t = UpgradeConfig.tools and UpgradeConfig.tools[key]
	local attr = (t and t.ownsAttr) or ("Owns" .. key)
	if lp:GetAttribute(attr) == true then
		return true
	end
	return lp:GetAttribute("Owns" .. key) == true
end

local function canAfford(price)
	price = tonumber(price)
	if not price then
		return false
	end
	return cash() + 1 >= price
end

local function toolStand(key)
	local folder = mapFolder("ToolsToBuy")
	if not folder then
		return nil
	end
	local info = UpgradeConfig.shop and UpgradeConfig.shop[key]
	local modelName = (info and info.model) or key
	return folder:FindFirstChild(modelName)
		or folder:FindFirstChild(key)
		or folder:FindFirstChild(modelName:gsub(" ", ""))
end

local function buyableTools()
	local q = QuestConfig.BUYABLE_TOOLS
	if type(q) == "table" and #q > 0 then
		return q
	end
	return CASH_TOOLS
end

local function tryBuyCashTool()
	if not BuyToolCash then
		return false
	end
	local shop = UpgradeConfig.shop
	local keys = {}
	local seen = {}
	for _, key in ipairs(buyableTools()) do
		if not seen[key] then
			seen[key] = true
			keys[#keys + 1] = key
		end
	end
	if type(shop) == "table" then
		for key, info in pairs(shop) do
			if type(info) == "table" and info.cash and not info.robuxOnly and not seen[key] then
				seen[key] = true
				keys[#keys + 1] = key
			end
		end
	end
	for _, key in ipairs(keys) do
		local info = shop and shop[key]
		local price = info and info.cash
		if (not info or (price and not info.robuxOnly)) and not toolOwned(key) and (not price or canAfford(price)) then
			if os.clock() - lastToolBuy < 1.1 then
				return false
			end
			lastToolBuy = os.clock()
			local stand = toolStand(key)
			if stand then
				tpTo(stand:IsA("BasePart") and stand.Position or stand:GetPivot().Position)
				task.wait(0.12)
			end
			BuyToolCash:FireServer(key)
			print("[HandCollect] tool", key, price, "cash", cash())
			return true
		end
	end
	return false
end

local function zoneDoorClosed(zone)
	local doors = mapFolder("Doors")
	if not (doors and zone) then
		return nil
	end
	for _, d in doors:GetChildren() do
		if d:IsA("Model") and d:GetAttribute("Zone") == zone and not d:GetAttribute("Open") then
			return d
		end
	end
	return nil
end

local function openZoneDoor(zone)
	if not zone or not zonePrereqReady(zone) then
		return false
	end
	local d = zoneDoorClosed(zone)
	if not d then
		return false
	end
	if os.clock() - lastDoor < 3.5 then
		return false
	end
	local pp = d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true)
	if not pp then
		return false
	end
	lastDoor = os.clock()
	tpTo(pp.Position)
	task.wait(0.15)
	DoorToggle:FireServer(d)
	print("[HandCollect] door", zone)
	return true
end

local lastClearPrint = 0
local lastFinish = 0
local stallAt, stallName, stallT = -1, "", 0

local function peekClearZone()
	if allZonesDone() then
		return nil
	end
	local fallback
	for _, name in ipairs(ZONE_ORDER) do
		local z = zoneModel(name)
		if z and z:GetAttribute("GoalTotal") and not zoneDone(name) and zonePrereqReady(name) then
			if stallName == name and os.clock() - stallT > 5 then
				fallback = fallback or name
			else
				return name
			end
		end
	end
	return fallback
end

local function nextClearZone()
	local name = peekClearZone()
	if not name then
		return nil
	end
	if name == "Garage" then
		pressGarage()
	end
	openZoneDoor(name)
	if os.clock() - lastClearPrint > 8 or lastClearName ~= name then
		lastClearPrint = os.clock()
		lastClearName = name
		local a, b, w, wt = zoneProgress(name)
		print("[HandCollect] zone", name, a .. "/" .. b, "wave", w .. "/" .. wt)
	end
	return name
end

local function tryFinishGame()
	local houseDone = MAP_NAME == "House" and zoneDone("Basement")
	if not (allZonesDone() or houseDone or RS:GetAttribute("RunCompleted") == true) then
		return false
	end
	if os.clock() - lastFinish < 2 then
		return true
	end
	lastFinish = os.clock()
	local vent = mapFolder("BasementVent")
	if vent then
		tpTo(vent:GetPivot().Position)
		task.wait(0.15)
		if BasementVentClick then
			BasementVentClick:FireServer()
		end
	end
	local hatch = workspace:FindFirstChild("Map")
	hatch = hatch and hatch:FindFirstChild("HatchDoor")
	if hatch and HatchClicked and RS:GetAttribute("RunCompleted") == true then
		tpTo(hatch:GetPivot().Position)
		task.wait(0.12)
		HatchClicked:FireServer()
	end
	local fall = mapFolder("PlayerFalling") or mapFolder("FallingLeaves")
	if fall then
		local pos = fall:IsA("BasePart") and fall.Position or fall:GetPivot().Position
		tpTo(pos)
	end
	print("[HandCollect] finish game")
	return true
end

