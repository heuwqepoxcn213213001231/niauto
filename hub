local function sitSquare()
 local teams = workspace:FindFirstChild("Teams")
 if not teams then
  return false
 end
 local char = LocalPlayer.Character
 local root = char and char:FindFirstChild("HumanoidRootPart")
 if not root then
  return false
 end
 for i = 1, 4 do
  local sq = teams:FindFirstChild("Square" .. i)
  if sq then
   local part = sq.PrimaryPart or sq:FindFirstChildWhichIsA("BasePart", true)
   if part then
    root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    return true
   end
  end
 end
 return false
end

