local function attrNumber(inst, names)
 if not inst then return nil end
 for _, n in ipairs(names) do
  local v = inst:GetAttribute(n)
  if type(v) == "number" then return v end
  if v == true then return 1 end
  local ch = inst:FindFirstChild(n)
  if ch then
   if ch:IsA("IntValue") or ch:IsA("NumberValue") then return ch.Value end
   if ch:IsA("BoolValue") and ch.Value then return 1 end
  end
 end
 return nil
end

local function mapBeaten(key)
 local n = beatenByMap[key]
 if type(n) == "number" and n > 0 then return n end
 local got = attrNumber(LocalPlayer, {
  key, key .. "Best", "Best" .. key, key .. "Difficulty",
  "Completed" .. key, "BestDifficulty" .. key,
 })
 if got then
  beatenByMap[key] = got
  return got
 end
 return n or 0
end

local function mapUnlocked(key)
 if key == "House" then return true end
 if unlockedMaps[key] == true then return true end
 if LocalPlayer:GetAttribute("Unlocked" .. key) == true then
  unlockedMaps[key] = true
  return true
 end
 if key == "Mansion" then return mapBeaten("House") >= 1 end
 if key == "GasStation" then return mapBeaten("Mansion") >= 1 end
 return false
end

local function diffUnlocked(idx, mapKey)
 idx = tonumber(idx) or 1
 if idx <= 1 then return true end
 local beaten = mapBeaten(mapKey or (getgenv().NiaFarmPrefs and getgenv().NiaFarmPrefs.map) or "House")
 if DiffCfg and DiffCfg.isUnlocked then
  return DiffCfg.isUnlocked(idx, beaten) == true
 end
 return idx <= math.clamp((tonumber(beaten) or 0) + 1, 1, #DIFF_OPTS)
end

local function ingestUnlockPayload(...)
 for i = 1, select("#", ...) do
  local v = select(i, ...)
  if type(v) == "table" then
   for k, val in pairs(v) do
    if k == "House" or k == "Mansion" or k == "GasStation" then
     if val == true then
      unlockedMaps[k] = true
     elseif type(val) == "number" then
      beatenByMap[k] = val
      if k == "House" or val >= 0 then unlockedMaps[k] = true end
     end
    end
   end
  end
 end
 if mapBeaten("House") >= 1 then unlockedMaps.Mansion = true end
 if mapBeaten("Mansion") >= 1 then unlockedMaps.GasStation = true end
end

