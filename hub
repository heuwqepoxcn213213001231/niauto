local function httpGet(url)
 local ok, body = pcall(function()
  return game:HttpGet(url)
 end)
 if ok and type(body) == "string" and #body > 80 and not body:lower():find("<html", 1, true) then
  return body
 end
 local req = (syn and syn.request) or http_request or request
 if type(req) == "function" then
  local ok2, res = pcall(req, { Url = url, Method = "GET" })
  if ok2 and type(res) == "table" and type(res.Body) == "string" and #res.Body > 80 then
   if not res.Body:lower():find("<html", 1, true) then
    return res.Body
   end
  end
 end
 return nil, tostring(body)
end

local function runLua(src, name)
 if type(src) ~= "string" then
  return false, "empty source"
 end
 src = src:gsub("^\239\187\191", ""):gsub("^%s+", "")
 local compiler = loadstring or load
 if type(compiler) ~= "function" then
  return false, "no loadstring"
 end
 local fn, compileErr = compiler(src, name or "@farm")
 if type(fn) ~= "function" then
  return false, tostring(compileErr or "compile failed")
 end
 local ok, err = pcall(fn)
 if not ok then
  return false, tostring(err)
 end
 return true
end

local function loadFarm()
 if type(getgenv().StartHandCollect) == "function" then
  return true
 end
 local farm, getErr = httpGet(CONFIG.FarmUrl .. "?t=" .. tostring(os.time()))
 if not farm then
  farm, getErr = httpGet(CONFIG.FarmUrl)
 end
 if not farm then
  warn("[Nia Hub] farm HttpGet", getErr)
  return false, "HttpGet FarmUrl failed"
 end
 farm = farm:gsub("function%s+getgenv%s*%(%s*%)%s*%.([%w_]+)%s*%(", "getgenv().%1 = function(")
 local ok, err = runLua(farm, "@Leaves")
 if not ok then
  warn("[Nia Hub] farm", err)
  return false, tostring(err)
 end
 if type(getgenv().StartHandCollect) ~= "function" then
  return false, "FarmUrl loaded but StartHandCollect missing"
 end
 return true
end

