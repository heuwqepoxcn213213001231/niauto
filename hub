local audio = {
 sfxOn = true,
 master = 0.8,
 music = 0.7,
 sfx = 0.85,
}

local function isMusicSound(sound)
 local n = string.lower(sound.Name)
 if sound.Looped then return true end
 return n:find("music", 1, true)
  or n:find("bgm", 1, true)
  or n:find("theme", 1, true)
  or n:find("soundtrack", 1, true)
  or n:find("ambient", 1, true)
end

local function applySound(sound)
 if not sound:IsA("Sound") then return end
 if sound:GetAttribute("NiaVol") == nil then
  sound:SetAttribute("NiaVol", sound.Volume)
 end
 local base = sound:GetAttribute("NiaVol")
 if not audio.sfxOn then
  sound.Volume = 0
  return
 end
 local bus = isMusicSound(sound) and audio.music or audio.sfx
 sound.Volume = math.clamp(base * audio.master * bus, 0, 2)
end

local function scanSounds(root)
 if not root then return end
 for _, inst in ipairs(root:GetDescendants()) do
  if inst:IsA("Sound") then applySound(inst) end
 end
end

local function applyAllSounds()
