local function mapCleared(key)
 return (beatenByMap[key] or 0) >= 1
end

local function mapUnlocked(key)
 if key == "House" then return true end
 if unlockedMaps[key] == true or mapCleared(key) then return true end
 if key == "Mansion" then return mapCleared("House") end
 if key == "GasStation" then return mapCleared("Mansion") end
 return false
end

local function highestOpen(mapKey)
 mapKey = mapKey or (getgenv().NiaFarmPrefs and getgenv().NiaFarmPrefs.map) or "House"
 local beaten = tonumber(beatenByMap[mapKey]) or 0
 if DiffCfg and DiffCfg.highestUnlocked then
  return DiffCfg.highestUnlocked(beaten)
 end
 return math.clamp(beaten + 1, 1, #DIFF_OPTS)
end

local function clampDiff(idx, mapKey)
 idx = tonumber(idx) or 1
 return math.clamp(math.min(idx, highestOpen(mapKey)), 1, #DIFF_OPTS)
end

local function diffUnlocked(idx, mapKey)
 idx = tonumber(idx) or 1
 return idx <= highestOpen(mapKey)
end

local function ingestUnlockPayload(...)
 for i = 1, select("#", ...) do
  local v = select(i, ...)
  if type(v) == "table" then
   walkProgress(v, 0)
  end
 end
