  return true
 end
 local url = farmUrl()
 local farm, getErr = httpGet(url .. "?t=" .. tostring(os.time()))
 if not farm then
  farm, getErr = httpGet(url)
 end
 if not farm then
  warn("[Nia Hub] farm HttpGet", GAME_NAME, getErr)
  return false, "HttpGet farm failed (" .. GAME_NAME .. ")"
 end
 farm = farm:gsub("function%s+getgenv%s*%(%s*%)%s*%.([%w_]+)%s*%(", "getgenv().%1 = function(")
 local ok, err = runLua(farm, "@" .. GAME_NAME)
 if not ok then
  warn("[Nia Hub] farm", err)
  return false, tostring(err)
 end
 if type(getgenv().StartHandCollect) ~= "function" then
  return false, "farm loaded but StartHandCollect missing"
 end
 print("[Nia Hub] farm", GAME_NAME, url)
 return true
end

