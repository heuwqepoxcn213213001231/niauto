local unlockedMaps = { House = true }
local beatenByMap = { House = 0, Mansion = 0, GasStation = 0 }

local function raiseBeaten(key, n)
 if key ~= "House" and key ~= "Mansion" and key ~= "GasStation" then
  return
 end
 n = tonumber(n)
 if not n then
  return
 end
 if n > (beatenByMap[key] or 0) then
  beatenByMap[key] = n
 end
 if n >= 1 then
  unlockedMaps[key] = true
 end
end

local function setBeaten(key, n)
 if key ~= "House" and key ~= "Mansion" and key ~= "GasStation" then
  return
 end
 n = tonumber(n)
 if n == nil then
  return
 end
 beatenByMap[key] = n
 if n >= 1 then
  unlockedMaps[key] = true
 end
end

local function takeMapValue(key, val)
 if key ~= "House" and key ~= "Mansion" and key ~= "GasStation" then
  return
 end
 if val == true then
  raiseBeaten(key, 1)
  return
 end
 if type(val) == "number" then
  if val > 0 then raiseBeaten(key, val) end
  return
 end
 if type(val) ~= "table" then
  return
 end
 local beaten = val.Best or val.BestDifficulty or val.Difficulty or val.Highest
  or val.Cleared or val.beaten or val.highest or val.MaxDifficulty
 if type(val.BestTime) == "number" and val.BestTime > 0 then
  raiseBeaten(key, type(beaten) == "number" and beaten or 1)
 elseif type(beaten) == "number" and beaten > 0 then
  raiseBeaten(key, beaten)
 elseif val.Unlocked == true or val.Completed == true then
  raiseBeaten(key, 1)
 end
end

local function walkProgress(t, depth)
 if type(t) ~= "table" or (depth or 0) > 6 then
  return
 end
 for k, v in pairs(t) do
  takeMapValue(k, v)
  if type(v) == "table" then
   walkProgress(v, (depth or 0) + 1)
  end
 end
end

local function scanGuiBest()
