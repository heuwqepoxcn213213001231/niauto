local function zonesLeft()
	local left, total = 0, 0
	local loc = mapFolder("Leave_Locations")
	if loc then
		for _, z in loc:GetChildren() do
			if z:IsA("Model") and z:GetAttribute("GoalTotal") then
				total = total + 1
				if z:GetAttribute("Completed") ~= true then
					left = left + 1
				end
			end
		end
	end
	return left, total
end

local function refreshHandCollectStatus()
	local st = getgenv().HandCollectStatus
	local cur, cap = bag()
	st.leaves = cur
	st.cap = cap
	st.cash = cash()
	if cap == math.huge then
		st.bag = tostring(cur) .. " / inf"
	elseif cap > 0 and cur >= cap then
		st.bag = "Full (" .. cur .. "/" .. cap .. ")"
	else
		st.bag = tostring(cur) .. " / " .. cap
	end
	local i, q, have = currentQuest()
	local qTotal = questCount()
	if i and q then
		st.quest = tostring(i) .. " / " .. qTotal
		st.questName = tostring(q.desc or q.id)
		st.questProg = tostring(have or 0) .. " / " .. tostring(q.total or 0)
	else
		st.quest = tostring(qTotal) .. " / " .. qTotal
		st.questName = "Done"
		st.questProg = "done"
	end
	st.zone = lastClearName ~= "" and lastClearName or "—"
	st.als = "—"
	if getgenv().HandCollectRunning == true then
		st.zones = zonesLeft() .. " left"
	else
		st.zones = st.zones or "—"
	end
	st.place = MAP_NAME
	st.map = MAP_NAME
	st.placeId = game.PlaceId
	return st
end

local function handCollectTick()
	equipHand()
	tryUpgradeBag()
	tryHandUpgrades()
	local q, have = tryQuest()
	if q and q.id == "SwishStreak" then
		task.wait(0.2)
		return
	end
	if tryFinishGame() then
		task.wait(0.4)
		return
	end
	local cur, cap = bag()
	local zonePref = nextClearZone()
	if not zonePref and q then
		if q.id == "CompleteGarage" then
			zonePref = "Garage"
		elseif type(q.zone) == "string" and zonePrereqReady(q.zone) then
			zonePref = q.zone
		end
	end
	local sellNow = cap ~= math.huge and cur >= cap and cur > 0
	if q and q.id == "SellLeaves" and cur > 0 then
		local needSell = math.max((q.total or 5) - (have or 0), 1)
		if cur >= needSell then
			sellNow = true
		end
	end
	if sellNow then
		sell()
		return
	end
	local need = cap == math.huge and 400 or math.max(0, cap - cur)
	if need <= 0 then
		return
	end
	local n = grab(need)
	if n == 0 then
		local got, tot = 0, 0
		if zonePref then
			got, tot = zoneProgress(zonePref)
			if stallName ~= zonePref or stallAt ~= got then
				stallName, stallAt, stallT = zonePref, got, os.clock()
				leftoverIdx = 0
				table.clear(leftoverSkip)
				leftoverCache, leftoverCacheAt, leftoverCacheZone = {}, 0, ""
			end
			local remain = tot > 0 and (tot - got) or 99
			if os.clock() - stallT > 2.5 and (got > 0 or remain <= 8) then
				table.clear(usedIds)
				failStreak = 0
				local leftover = leftoverZoneLeaf(zonePref)
				if leftover then
					n = grabLeftover(leftover, need)
					if n == 0 then
						leftoverSkip[leftover] = true
					end
					if os.clock() - lastTelePrint > 3 then
						lastTelePrint = os.clock()
						print("[HandCollect] leftover", zonePref, got .. "/" .. tot)
					end
				end
			end
		end
		if n == 0 and teleToZoneLeaf(zonePref) then
			task.wait(0.08)
			n = grab(need)
			if os.clock() - lastTelePrint > 4 then
				lastTelePrint = os.clock()
				print("[HandCollect] tele+grab", zonePref or "", n)
			end
		end
	elseif n > 0 and os.clock() - lastGrabPrint > 2 then
		lastGrabPrint = os.clock()
		print("[HandCollect]", cur + n, "/", cap == math.huge and "inf" or cap, "+", n)
	end
end

local function startHandCollect()
	if getgenv().HandCollectRunning then
		return
	end
	getgenv().StopHandCollect = false
	getgenv().HandCollectRunning = true
	getgenv().HandCollectStatus.running = true
	equipHand()
	print("[HandCollect] clear-map", MAP_NAME, "| tat: getgenv().StopHandCollect = true")
	task.spawn(function()
		while not getgenv().StopHandCollect do
			handCollectTick()
			task.wait(0.08)
		end
		getgenv().HandCollectRunning = false
		getgenv().HandCollectStatus.running = false
		print("[HandCollect] stop")
	end)
end

local function stopHandCollectRun()
	getgenv().StopHandCollect = true
end

getgenv().RefreshHandCollectStatus = refreshHandCollectStatus
getgenv().StartHandCollect = startHandCollect
getgenv().StopHandCollectRun = stopHandCollectRun

if not getgenv().HandCollectHub then
	startHandCollect()
end
