local function trySwish()
	if not (BasketballPickup and BasketballRelease and BasketballGoal) then
		return false
	end
	if os.clock() - lastSwish < 2.4 then
		return false
	end
	lastSwish = os.clock()
	lp:SetAttribute("JournalOpen", false)
	lp:SetAttribute("ToolShopFocus", false)
	local hoop = hoopPart()
	local model = mapFolder("Basketball")
	local col = ballCollider()
	local ball = model and model:FindFirstChild("BasketBall")
	if not (hoop and model and col) then
		warn("[HandCollect] no basketball")
		return false
	end
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	if not holdingBall(col) then
		local pos = (ball or col).Position
		tpTo(pos)
		task.wait(0.12)
		local root = hrp()
		if root then
			cam.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 2, 0), pos)
		end
		task.wait(0.08)
		BasketballPickup:FireServer()
		clickAction()
		local t0 = os.clock()
		repeat
			task.wait(0.05)
		until holdingBall(col) or os.clock() - t0 > 1.1
	end
	local net = hoop.Position
	local stand = Vector3.new(net.X + 12, net.Y - 7, net.Z)
	tpTo(stand)
	task.wait(0.1)
	local root = hrp()
	if root then
		cam.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 1.6, 0), net)
		task.wait(0.08)
		col.CFrame = cam.CFrame * CFrame.new(0, -1.4, -4)
	end
	BasketballRelease:FireServer()
	lp:SetAttribute("HoldingBasketball", false)
	local ev = RS:FindFirstChild("MobileActionEvent")
	if ev and ev:IsA("BindableEvent") then
		ev:Fire("shoot", "began")
	end
	local above = net + Vector3.new(0, 3.2, 0)
	local below = net + Vector3.new(0, -4, 0)
	col.Anchored = false
	col.CFrame = CFrame.new(above)
	col.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
	col.AssemblyAngularVelocity = Vector3.zero
	for i = 1, 10 do
		col.CFrame = CFrame.new(above:Lerp(below, i / 10))
		col.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
		task.wait(0.03)
	end
	BasketballGoal:FireServer(true)
	print("[HandCollect] swish throw")
	return true
end

function tryQuest()
	local i, q, have = currentQuest()
	if not q then
		return nil
	end
	if q.id ~= lastQuestId then
		lastQuestId = q.id
		print("[HandCollect] quest", q.desc or q.id, have .. "/" .. q.total)
	end
	if q.id == "CollectLeaves" or q.id == "SellLeaves" then
		return q, have
	end
	if q.id == "OpenJournal" then
		if os.clock() - lastJournal > 2 then
			lastJournal = os.clock()
			lp:SetAttribute("JournalOpen", true)
			if JournalOpened then
				JournalOpened:FireServer()
			end
			task.delay(0.45, function()
				lp:SetAttribute("JournalOpen", false)
			end)
			print("[HandCollect] journal")
		end
		return q, have
	end
	if q.id == "UpgradeHand" then
		tryBuyHand("Hold")
		return q, have
	end
	if q.id == "OpenGarage" then
		pressGarage()
		return q, have
	end
	if q.id == "CompleteGarage" then
		pressGarage()
		return q, have
	end
	if q.id == "BuyTool" or q.id == "BuyAllTools" then
		tryBuyCashTool()
		return q, have
	end
	if q.id == "BuyVent" or q.id == "BuyAllVents" then
		tryBuyVent()
		return q, have
	end
	if q.id == "UnlockAllZones" then
		local cur = peekClearZone()
		local zones = QuestConfig.ALL_ZONES or { "Rooftop", "Backyard", "Maze", "Farm", "Basement" }
		for _, z in ipairs(zones) do
			if (not cur or cur == z) and zonePrereqReady(z) and zoneDoorClosed(z) then
				openZoneDoor(z)
				break
			end
		end
		return q, have
	end
	if q.id == "SwishStreak" then
		trySwish()
		return q, have
	end
	if type(q.zone) == "string" then
		local cur = peekClearZone()
		if (cur == q.zone or not cur) and zonePrereqReady(q.zone) then
			openZoneDoor(q.zone)
		end
		return q, have
	end
	return q, have
end

